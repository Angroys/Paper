          "label": "Orange"
        }
      },
      "precomputed": {
        "$description": "Ready #RRGGBBAA values (wash @ rest alpha).",
        "whitePaper": {
          "yellow": "#fbbf241a",
          "green": "#4ade801a",
          "blue": "#60a5fa1a",
          "pink": "#f472b61a",
          "purple": "#a78bfa1a",
          "orange": "#fb923c1a"
        },
        "darkPaper": {
          "yellow": "#fbbf2452",
          "green": "#4ade8052",
          "blue": "#60a5fa52",
          "pink": "#f472b652",
          "purple": "#a78bfa52",
          "orange": "#fb923c52"
        }
      },
      "pending": {
        "$value": "#fbbf2466",
        "$description": "Just-created selection awaiting action (web --highlight-mark-pending, frozen)"
      },
      "cornerRadius": 2,
      "hoverRingWidth": 1.5,
      "focusRingWidth": 2,
      "hoverScale": 1.02
    },
    "readerMarks": {
      "$description": "AI-generated reader marks — exact web values (globals.css). Rest wash = opaque `wash` color in a per-family layer at `restAlpha`, multiply over white paper. Hover = `full`, pressed = `active`, ring = opaque `ring` 1.5dp; keyboard focus uses focusRingOnPaper 2dp.",
      "restAlpha": 0.1,
      "term": {
        "wash": "#60a5fa",
        "full": "#3b82f68c",
        "active": "#3b82f6ad",
        "ring": "#2563eb",
        "underline": "#2563eb",
        "role": "Known cached glossary term (blue)"
      },
      "citation": {
        "wash": "#818cf8",
        "full": "#6366f18c",
        "active": "#6366f1ad",
        "ring": "#4f46e5",
        "role": "Citation (indigo)"
      },
      "appendix": {
        "wash": "#2dd4bf",
        "full": "#14b8a68c",
        "active": "#14b8a6ad",
        "ring": "#0d9488",
        "role": "Appendix / in-doc jump (teal)"
      },
      "mention": {
        "wash": "#a3a3a3",
        "full": "#7373738c",
        "active": "#737373ad",
        "ring": "#525252",
        "role": "External mention (gray)"
      }
    },
    "web": {
      "$description": "Exact web colours by Tailwind/CSS-var name (dark theme). Dart: PaperWeb.*",
