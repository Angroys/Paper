        "default": 384,
        "min": 300,
        "maxFraction": 0.5
      },
      "large": {
        "mode": "split",
        "default": 384,
        "min": 300,
        "maxFraction": 0.5
      },
      "extraLarge": {
        "mode": "split",
        "default": 384,
        "min": 320,
        "maxFraction": 0.45
      },
      "closeSnapBelowMin": 48,
      "webWidth": 384
    },
    "pdfViewportMin": 480,
    "pdfViewportMinExtraLarge": 720,
    "tailwind": {
      "sm": 640,
