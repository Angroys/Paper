  "breakpoints": {
    "$description": "Window width in logical dp (MediaQuery.sizeOf(context).width). Material 3 window-size-class aligned. Min-width, mobile-first.",
    "$specNames": "design/specs/layout-system.md uses the same ranges as PaperWindowClass: compact <600, medium 600-839, expanded 840-1199, large 1200-1599, extraLarge >=1600.",
    "compact": {
      "min": 0,
      "max": 599,
      "target": "Split-screen / narrow window / phone",
      "layout": "Single pane; bottom NavigationBar; side panel as modal bottom sheet (snap 40% / 90%)"
    },
    "medium": {
      "min": 600,
      "max": 839,
      "target": "Tablet portrait",
