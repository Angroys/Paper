  "motion": {
    "$description": "Web parity: --mark-press-duration 80, --mark-reveal-duration 150, --mark-settle-duration 200, --focus-lock-dur-backdrop 300, --focus-lock-dur-enter 420. Animate only opacity/transform (compositor-cheap). Respect MediaQuery.disableAnimations → use `instant` or Duration.zero.",
    "duration": {
      "instant": {
        "$value": 80,
        "use": "Press/active deepen, toggles"
      },
      "fast": {
        "$value": 150,
        "use": "Hover/focus reveal, tooltips, small fades"
      },
      "base": {
        "$value": 200,
        "use": "Settle/out, color changes, panel content swaps"
      },
      "slow": {
        "$value": 300,
        "use": "Scrims, side panel open/close, sheets"
      },
      "page": {
        "$value": 300,
        "use": "Route transitions. The web has none (instant navigation); kept for the app shell, see tokens.md"
      },
      "emphasis": {
        "$value": 420,
        "use": "One-off hero moves (focus-lock lift); never on scroll paths"
      },
      "hoverDelay": {
        "$value": 40,
        "use": "Pointer hover-in anti-strobe delay (not keyboard focus)"
      },
      "colors": {
        "$value": 150,
        "use": "Tailwind transition-colors/-transform default (ease = standard)"
      },
      "backdrop": {
        "$value": 300
      },
      "spin": {
        "$value": 1000,
        "use": "animate-spin, linear"
      },
      "pulse": {
        "$value": 2000,
        "use": "animate-pulse, cubic-bezier(0.4,0,0.6,1), opacity 1 -> .5"
      },
      "progressIndeterminate": {
        "$value": 1200,
        "use": "ease-in-out, translateX -100% -> 300%"
      }
    },
    "easing": {
      "standard": {
        "$value": [
          0.4,
          0.0,
          0.2,
          1.0
        ],
        "use": "In-place changes, departures (web --mark-ease-settle)"
      },
      "decelerate": {
        "$value": [
          0.0,
          0.0,
          0.2,
          1.0
        ],
        "use": "Arrivals/reveals (web --mark-ease-reveal)"
      },
      "accelerate": {
        "$value": [
          0.4,
          0.0,
          1.0,
          1.0
        ],
        "use": "Exits off-screen"
      },
      "linear": {
        "$value": [
          0.0,
          0.0,
          1.0,
          1.0
        ],
        "use": "Progress, opacity crossfades in lists"
      }
    },
    "scale": {
      "markHover": 1.02,
      "termHover": 1.04,
      "press": 0.98
    },
