    "hysteresisDp": 8,
    "sidePanel": {
      "$description": "ReaderSidePanel per window class. maxFraction is of the window width. A split that would leave the PDF narrower than pdfViewportMin falls back to overlay. compact = bottom sheet (full width, no width tokens).",
