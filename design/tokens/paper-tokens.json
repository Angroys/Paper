        },
        "handle": {
          "$value": "#818cf8"
        }
      },
      "textSubtle": {
        "$value": "#737373",
        "$description": "dark:text-gray-500 (chevrons, rare meta). Dart: PaperWeb.gray500",
        "contrast": "3.78:1 on surface — web parity, not AA for small text"
      }
    },
    "highlight": {
      "$description": "User highlight palette (text + figure highlights, stylus ink). Web ships one user color (amber); the app adds 5 hues built with the SAME recipe: wash = Tailwind-400 hue, reveal = 500 @ 0.55, active = 500 @ 0.68, ring = 600 opaque (>=3:1 on white). `whitePaper` values paint with BlendMode.multiply over the white PDF (glyphs stay dark; same-color overlaps must be painted in ONE layer with a single alpha — web no-stacking contract). `darkPaper` values are for the optional inverted/night page mode where multiply would go black: paint srcOver at the given alpha.",
      "blendMode": {
        "whitePaper": "multiply",
        "darkPaper": "srcOver"
      },
      "alpha": {
        "whitePaper": {
          "rest": 0.1,
          "hover": 0.55,
          "active": 0.68,
          "note": "rest = web --highlight-wash-opacity 0.10 (opaque wash, one layer per hue, multiply); hover 0.55 / active 0.68 = --highlight-mark-full / -active"
        },
        "darkPaper": {
          "rest": 0.32,
          "hover": 0.45,
          "active": 0.55
        },
        "stylusInk": {
          "whitePaper": 0.45,
          "darkPaper": 0.36,
          "note": "Pen-highlighter strokes; one layer per color per page (no self-darkening)"
        }
      },
      "colors": {
        "yellow": {
          "wash": "#fbbf24",
          "reveal": "#f59e0b",
          "ring": "#d97706",
          "ringContrastOnWhite": "3.19:1",
          "default": true,
          "label": "Yellow"
        },
        "green": {
          "wash": "#4ade80",
          "reveal": "#22c55e",
          "ring": "#16a34a",
          "ringContrastOnWhite": "3.30:1",
          "label": "Green"
        },
        "blue": {
          "wash": "#60a5fa",
          "reveal": "#3b82f6",
          "ring": "#2563eb",
          "ringContrastOnWhite": "5.17:1",
          "label": "Blue"
        },
        "pink": {
